# Use the URL and PUBLIC (publishable) key of the SAME Supabase project.
# Do not put a secret/service_role key in NEXT_PUBLIC_* or commit it to git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Required by existing browser components; use the SAME publishable key here
# until all clients have migrated to the new variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Compatibility with the legacy browser client in the existing WeedReset code:
# The NEXT_PUBLIC_SUPABASE_ANON_KEY variable can contain either the new
# publishable key or an older anon key (use the publishable key when possible).

# For server-only endpoints that genuinely need privileged access:
# SUPABASE_SECRET_KEY=  # keep only in Vercel encrypted environment variables

# WeedReset Play Billing (server-side secrets; never use NEXT_PUBLIC_ for these).
# Leave switch OFF until real TWA/merchant setup, tested migration, and RTDN.
WEEDRESET_PAID_ACCESS_ENABLED=false
# ISO date/time of planned release. Existing accounts get their trial from this date.
WEEDRESET_ACCESS_LAUNCH_DATE=
# Exact Android app ID in your Play Console (not automatically reserved).
GOOGLE_PLAY_PACKAGE_NAME=
# JSON service account with Android Publisher access, stored only in Vercel secrets.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Supabase service role/secret API key, only in Vercel encrypted server env:
SUPABASE_SERVICE_ROLE_KEY=
# Or use the existing SUPABASE_SECRET_KEY server-side if appropriate.
