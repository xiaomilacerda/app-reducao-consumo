# Use the URL and PUBLIC (publishable) key of the SAME Supabase project.
# Do not put a secret/service_role key in NEXT_PUBLIC_* or commit it to git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Compatibility with the legacy browser client in the existing WeedReset code:
# If using the legacy key, set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For server-only endpoints that genuinely need privileged access:
# SUPABASE_SECRET_KEY=  # keep only in Vercel encrypted environment variables
